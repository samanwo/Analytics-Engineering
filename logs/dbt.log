    as (
with source as(
    select
        c.id as customer_id,
        e.id as employee_id,
        pod.purchase_order_id,
        pod.product_id,
        pod.quantity,
        pod.unit_cost,
        pod.date_received,
        pod.posted_to_inventory,
        pod.inventory_id,
        po.supplier_id,
        po.created_by,
        po.submitted_date,
        date(po.creation_date) as creation_date,
        po.status_id,
        po.expected_date,
        po.shipping_fee,
        po.taxes,
        po.payment_date,
        po.payment_amount,
        po.payment_method,
        po.notes,
        po.approved_by,
        po.approved_date,
        po.submitted_by,
        current_timestamp() as insertion_timestamp
    from NORTHWIND_DB.DL_NORTHWIND_stg_northwind.stg_purchase_orders po
    left join NORTHWIND_DB.DL_NORTHWIND_stg_northwind.stg_purchase_order_details pod
    on pod.purchase_order_id = po.id
    left join NORTHWIND_DB.DL_NORTHWIND_stg_northwind.stg_products p
    on p.id = pod.product_id
    left join NORTHWIND_DB.DL_NORTHWIND_stg_northwind.stg_order_details od
    on od.product_id = p.id
    left join NORTHWIND_DB.DL_NORTHWIND_stg_northwind.stg_orders o
    on o.id = od.order_id
    left join NORTHWIND_DB.DL_NORTHWIND_stg_northwind.stg_employees e
    on e.id = po.created_by
    left join NORTHWIND_DB.DL_NORTHWIND_stg_northwind.stg_customer c
    on c.id = o.customer_id
    where o.customer_id is not null
),

unique_source as (
    select *,
           row_number() over (partition by customer_id, employee_id, purchase_order_id, product_id, inventory_id, supplier_id, creation_date order by insertion_timestamp desc) as rn_col
    from source
),

filtered_unique as (
    select * 
    from unique_source
    where rn_col = 1
)

-- In Snowflake, use EXCLUDE instead of EXCEPT
select * exclude (rn_col)
from filtered_unique
    )

