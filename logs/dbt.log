    as (
with source as(
    select
        od.order_id,
        od.product_id,
        o.customer_id,
        o.employee_id,
        o.shipper_id,
        od.quantity,
        od.unit_price,
        od.discount,
        od.status_id,
        od.date_allocated,
        od.purchase_order_id,
        od.inventory_id,
        date(o.order_date) as order_date,
        o.shipped_date,
        o.paid_date,
        current_timestamp() as insertion_timestamp,
    from NORTHWIND_DB.DL_NORTHWIND_stg_northwind.stg_orders o
    left join NORTHWIND_DB.DL_NORTHWIND_stg_northwind.stg_order_details od
    on od.order_id = o.id
    where od.order_id is not null
),

unique_source as (
    select *,
           row_number() over (partition by customer_id, employee_id, order_id, product_id, shipper_id, purchase_order_id, shipper_id, order_date order by insertion_timestamp desc) as rn_col
    from source
),

filtered_unique as (
    select * 
    from unique_source
    where rn_col = 1
)

-- In Snowflake, use EXCLUDE instead of EXCEPT
select * exclude (rn_col)
from filtered_unique
    )

